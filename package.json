{
  "name": "manim-online",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:browser": "node tests/browser/all.cjs",
    "check": "node scripts/check.mjs",
    "offline": "node scripts/update-offline.mjs",
    "gallery": "node scripts/render-kit-gallery.mjs",
    "gallery:manim": "node scripts/render-gallery.cjs",
    "docs": "node scripts/render-docs.mjs",
    "serve": "node vendor/fragment-kit-v0.3.3/tools/serve.mjs --port 8000",
    "test:contracts": "playwright test --config vendor/fragment-kit-v0.3.3/testing/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1"
  }
}
