{
  "name": "fragment-kit",
  "version": "0.3.5",
  "description": "Buildless, browser-native tools for apps with state in URL fragments",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "exports": { ".": "./src/index.js", "./globals.js": "./src/globals.js", "./*": "./src/*" },
  "bin": { "fragment-kit": "./tools/vendor-sync.mjs" },
  "files": ["src", "vendor", "tools", "testing", "docs", "manifest.json", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node tools/check.mjs && node tools/offline-assets.mjs --config demo/offline.config.json --check && node tools/vendor-sync.mjs --check --target demo && node tools/render-gallery.mjs --config demo/gallery.config.mjs --check",
    "test:browser": "playwright test --config testing/playwright.config.js",
    "test:contracts": "playwright test --config testing/playwright.config.js",
    "serve": "node tools/serve.mjs",
    "demo": "node tools/prepare-demo.mjs",
    "release:prepare": "node tools/release.mjs",
    "corpus:harvest": "node tools/harvest-corpus.mjs"
  },
  "devDependencies": { "@playwright/test": "1.64.1" }
}
